# Copy to .env and adjust. EXPO_PUBLIC_ values are built into the app bundle,
# so never put secrets here. Restart Metro after changing them.

# Where the API is. The iOS Simulator shares the Mac's network, so localhost
# works there. An Android emulator needs http://10.0.2.2:3100 and a physical
# phone needs the Mac's LAN address, e.g. http://192.168.1.20:3100.
EXPO_PUBLIC_API_URL=http://localhost:3100

# From `eas init`. Without it the app runs normally but can't get a push token.
EAS_PROJECT_ID=

# Physical devices only. A bundle id / package registered to you, and the
# Apple team that signs the iOS build (10 characters, from
# developer.apple.com > Membership). Push on iOS needs a paid team.
# Leave both empty for the Simulator and an emulator.
APP_ID=
APPLE_TEAM_ID=
