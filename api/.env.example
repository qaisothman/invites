# Local development, as docs/00-run-and-test-locally.md uses it.
NODE_ENV=development
# Proxies in front of the API that set X-Forwarded-For: 0 here, where clients
# connect directly; 1 behind one load balancer. Production requires it.
TRUST_PROXY_HOPS=0
# The app expects the API on 3100.
PORT=3100
API_PUBLIC_URL=http://localhost:3100
# docker compose's db. With a local Postgres, drop "postgres@" to use your own role.
DATABASE_URL=postgres://postgres@localhost:5432/nest_invites
JWT_SECRET=local-only-secret-change-me-0123456789
# Accepts every push without sending it. "expo" sends real pushes.
PUSH_DRIVER=fake
# How long an invitation no phone can show waits before its email. 900 (15 minutes) by default.
EMAIL_AFTER_SECONDS=20
